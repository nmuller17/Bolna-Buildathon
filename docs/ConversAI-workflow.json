": 365.6666666666667}, {"t": "circle", "cx": 45.0, "cy": 161.24500000000003, "r": 1.5, "fill": "5B6578"}, {"t": "text", "x": 51.0, "y": 158.44000000000003, "lines": ["deterministic, unit-tested: 20 / 20 vocabulary sentences"], "size": 8.5, "bold": false, "color": "1B2433", "align": "left", "leading": 10.88, "w": 365.6666666666667}, {"t": "rect", "x": 442.6666666666667, "y": 112, "w": 394.6666666666667, "h": 168, "fill": "FFFFFF", "stroke": "D5DCE5", "lw": 1, "r": 8, "dash": false}, {"t": "rect", "x": 442.6666666666667, "y": 254, "w": 394.6666666666667, "h": 26, "fill": "1E9E5A", "stroke": null, "lw": 0, "r": 8, "dash": false}, {"t": "rect", "x": 442.6666666666667, "y": 254, "w": 394.6666666666667, "h": 10.0, "fill": "1E9E5A", "stroke": null, "lw": 0, "r": 0, "dash": false}, {"t": "text", "x": 452.6666666666667, "y": 262, "lines": ["Sign classifier"], "size": 10.5, "bold": true, "color": "FFFFFF", "align": "left", "leading": 12.6, "w": 75.197998046875}, {"t": "text", "x": 452.6666666666667, "y": 238, "lines": ["Trained \u00b7 PyTorch \u00b7 on our own data"], "size": 9.5, "bold": true, "color": "1E9E5A", "align": "left", "leading": 12.16, "w": 374.6666666666667}, {"t": "circle", "cx": 455.6666666666667, "cy": 225.645, "r": 1.5, "fill": "5B6578"}, {"t": "text", "x": 461.6666666666667, "y": 222.84, "lines": ["data: 1,320 takes = 5 signers \u00d7 22 classes \u00d7 12, MediaPipe (capture/train_session.py)"], "size": 8.5, "bold": false, "color": "1B2433", "align": "left", "leading": 10.88, "w": 365.6666666666667}, {"t": "circle", "cx": 455.6666666666667, "cy": 212.26500000000001, "r": 1.5, "fill": "5B6578"}, {"t": "text", "x": 461.6666666666667, "y": 209.46, "lines": ["input: 32 steps \u00d7 141 features \u2192 7 stats each (mean, std, min, max, 3 thirds) = 987 values,", "standardized"], "size": 8.5, "bold": false, "color": "1B2433", "align": "left", "leading": 10.88, "w": 365.6666666666667}, {"t": "circle", "cx": 455.6666666666667, "cy": 188.00500000000002, "r": 1.5, "fill": "5B6578"}, {"t": "text", "x": 461.6666666666667, "y": 185.20000000000002, "lines": ["model: multinomial logistic regression = 1 linear layer 987 \u2192 22 (21,736 params), softmax +", "cross-entropy"], "size": 8.5, "bold": false, "color": "1B2433", "align": "left", "leading": 10.88, "w": 365.6666666666667}, {"t": "circle", "cx": 455.6666666666667, "cy": 163.74500000000003, "r": 1.5, "fill": "5B6578"}, {"t": "text", "x": 461.6666666666667, "y": 160.94000000000003, "lines": ["training: L-BFGS (300 it.), L2 \u03bb = 0.001, temperature 1.53 fitted on a held-out signer"], "size": 8.5, "bold": false, "color": "1B2433", "align": "left", "leading": 10.88, "w": 365.6666666666667}, {"t": "circle", "cx": 455.6666666666667, "cy": 150.36500000000004, "r": 1.5, "fill": "5B6578"}, {"t": "text", "x": 461.6666666666667, "y": 147.56000000000003, "lines": ["beat a 2-layer BiGRU (AdamW, augmentation): 89.8 % vs 87.9 % (leave-one-signer-out)"], "size": 8.5, "bold": false, "color": "1B2433", "align": "left", "leading": 10.88, "w": 365.6666666666667}, {"t": "rect", "x": 853.3333333333334, "y": 112, "w": 394.6666666666667, "h": 168, "fill": "FFF1E6", "stroke": "E8590C", "lw": 2.6, "r": 8, "dash": false}, {"t": "rect", "x": 853.3333333333334, "y": 254, "w": 394.6666666666667, "h": 26, "fill": "E8590C", "stroke": null, "lw": 0, "r": 8, "dash": false}, {"t": "rect", "x": 853.3333333333334, "y": 254, "w": 394.6666666666667, "h": 10.0, "fill": "E8590C", "stroke": null, "lw": 0, "r": 0, "dash": false}, {"t": "text", "x": 863.3333333333334, "y": 262, "lines": ["Intent decoder \u2014 guest"], "size": 10.5, "bold": true, "color": "FFFFFF", "align": "left", "leading": 12.6, "w": 120.67919921875001}, {"t": "text", "x": 863.3333333333334, "y": 238, "lines": ["Algorithm \u00b7 Python / NumPy \u00b7 no training"], "size": 9.5, "bold": true, "color": "E8590C", "align": "left", "leading": 12.16, "w": 374.6666666666667}, {"t": "circle", "cx": 866.3333333333334, "cy": 225.645, "r": 1.5, "fill": "5B6578"}, {"t": "text", "x": 872.3333333333334, "y": 222.84, "lines": ["input: classifier probabilities on sliding 1 s windows"], "size": 8.5, "bold": false, "color": "1B2433", "align": "left", "leading": 10.88, "w": 365.6666666666667}, {"t": "circle", "cx": 866.3333333333334, "cy": 212.26500000000001, "r": 1.5, "fill": "5B6578"}, {"t": "text", "x": 872.3333333333334, "y": 209.46, "lines": ["each of the 22 guest sentences is aligned on the windows: its signs in order, each on a", "contiguous run (monotonic dynamic programming)"], "size": 8.5, "bold": false, "color": "1B2433", "align": "left", "leading": 10.88, "w": 365.6666666666667}, {"t": "circle", "cx": 866.3333333333334, "cy": 188.00500000000002, "r": 1.5, "fill": "5B6578"}, {"t": "text", "x": 872.3333333333334, "y": 185.20000000000002, "lines": ["score = mean log-probability; the best sentence wins, so misread signs are fixed by the sentence"], "size": 8.5, "bold": false, "color": "1B2433", "align": "left", "leading": 10.88, "w": 365.6666666666667}, {"t": "circle", "cx": 866.3333333333334, "cy": 174.62500000000003, "r": 1.5, "fill": "5B6578"}, {"t": "text", "x": 872.3333333333334, "y": 171.82000000000002, "lines": ["window length tuned on a held-out signer: 1 s \u2192 90 %, 1.7 s \u2192 84 %"], "size": 8.5, "bold": false, "color": "1B2433", "align": "left", "leading": 10.88, "w": 365.6666666666667}, {"t": "rect", "x": 32.0, "y": 24, "w": 394.6666666666667, "h": 70, "fill": "F5F7FA", "stroke": "D5DCE5", "lw": 1, "r": 8, "dash": false}, {"t": "text", "x": 44.0, "y": 76, "lines": ["Turn-taking  web/lib/turns.ts"], "size": 10, "bold": true, "color": "0E2A47", "align": "left", "leading": 12.0, "w": 137.8916015625}, {"t": "text", "x": 44.0, "y": 61, "lines": ["FRONT DESK \u2192 GUEST \u2192 SPEAKING \u2192 FRONT DESK \u00b7 mic muted during the guest turn \u00b7", "events via POST /api/guest/signs \u2192 SSE"], "size": 8.4, "bold": false, "color": "1B2433", "align": "left", "leading": 10.752, "w": 370.6666666666667}, {"t":